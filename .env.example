# Скопируй этот файл в .env и впиши свой ключ:  cp .env.example .env
# ВНИМАНИЕ: файл .env никогда не коммитим (он в .gitignore). Репозиторий станет публичным.

# Google Gemini API, бесплатный ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=
# Основная модель: на бесплатном тарифе у Flash-Lite самый большой дневной лимит
# (по данным на 25.11.2026: 15 RPM, 500 RPD; у gemini-3.8-flash всего 20 RPD).
# gemini-1.5-flash из примера организаторов больше не существует.
# Источник и запасные модели: docs/research/05-llm-apis.md. Точные лимиты своего ключа: AI Studio → Rate limit.
GEMINI_MODEL=gemini-3.5-flash-lite

# Запасные провайдеры (по желанию)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
