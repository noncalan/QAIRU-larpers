# Скопируй этот файл в .env и впиши свой ключ:  cp .env.example .env
# ВНИМАНИЕ: файл .env никогда не коммитим (он в .gitignore). Репозиторий станет публичным.

# Claude API (решение D-006 в docs/decisions.md).
# Ключ: https://platform.claude.com/ → API keys, или ключ командного аккаунта, полученный лично.
# SDK anthropic читает его из окружения сам.
ANTHROPIC_API_KEY=

# Модели заданы по шагам в src/validator/config.py (STEP_MODELS, решение D-010), здесь не настраиваются.

# Версия агента для паспорта прогона, если запуск не из git-клона (иначе берётся git describe).
AGENT_VERSION=

# Папка с записанными ответами модели для --backend fake (по умолчанию tests/fixtures/llm).
VALIDATOR_FAKE_FIXTURES=
