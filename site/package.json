{
  "name": "qairu-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1 --port 5173",
    "build": "npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy": "vercel build --prod --yes && vercel deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.4.0"
  }
}
